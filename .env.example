# =============================================================================
# HANA 数据库配置
# =============================================================================
HANA_HOST=your_hana_host
HANA_PORT=30015
HANA_USER=your_username
HANA_PASSWORD=your_password
HANA_DATABASE=SYSTEMDB

# HANA 连接池配置
HANA_POOL_SIZE=5
HANA_MAX_OVERFLOW=10
HANA_POOL_RECYCLE=3600

# =============================================================================
# MSSQL 数据库配置
# =============================================================================
MSSQL_HOST=your_mssql_host
MSSQL_PORT=1433
MSSQL_USER=your_username
MSSQL_PASSWORD=your_password
MSSQL_DATABASE=your_database

# MSSQL 连接池配置
MSSQL_POOL_SIZE=5
MSSQL_MAX_OVERFLOW=10
MSSQL_POOL_RECYCLE=3600

# =============================================================================
# 业务配置
# =============================================================================
HANA_TABLE=voucher_header
MSSQL_TABLE=voucher_table
START_DATE=2024-01-01
END_DATE=2024-12-31
OUTPUT_PATH=output/processed_data.xlsx
OUTPUT_SHEET_NAME=数据
