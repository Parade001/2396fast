# ==============================================================================
# SAP2FAST 环境变量配置模板 (.env.example)
# 使用方法：复制本文件为 `.env` 并填入实际连接信息与账号密码
# ==============================================================================

# 1. 抽取期间范围 (格式: YYYYMMDD)
START_DATE=20240301
END_DATE=20240331

# 2. SAP S/4HANA 数据库连接配置
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
HANA_DATABASE=SYSTEMDB
HANA_TABLE=ACDOCA
HANA_POOL_SIZE=5
HANA_MAX_OVERFLOW=10
HANA_POOL_RECYCLE=3600

# 3. 越南 FAST (SQL Server / MSSQL) 数据库连接配置
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=2396fast
MSSQL_TABLE=c11$000000
MSSQL_POOL_SIZE=5
MSSQL_MAX_OVERFLOW=10
MSSQL_POOL_RECYCLE=3600

# 4. 越南 FAST Web 端自动登录凭据配置 (供需求 7 自动上传与过账使用)
# 也可在 config/fast_credentials.yaml 中直接填写
FAST_URL=http://10.7.3.230/FAW_TIMBERLAND/Main/Login.aspx
FAST_USER=
FAST_PASSWORD=
FAST_UNIT=CTY
# 登录界面语言：en (自动切换为英文界面) / vi (默认越南语)
FAST_LANGUAGE=en

# 5. Chrome CDP 浏览器调试配置
CHROME_PATH=
CHROME_PORT=9222

# 5. 导出文件路径配置
OUTPUT_PATH=output/processed_data.xlsx
OUTPUT_SHEET_NAME=Sheet1